#!/usr/bin/env python3
"""Tulpar izleme ekranı (görev yöneticisi gibi).

Üstte: sıcaklık, CPU, gerçek toplam RAM (model dahil), swap (sanal RAM) ve SSD trafiği, uygulama tablosu.
Altta: Tulpar olayları (canlı). Kaydırma: ↑↓ satır, PgUp/PgDn sayfa, Home en eski, End canlı akış.
s: sunucu ayarları menüsü. q: çıkış.
"""
import curses
import glob
import os
import subprocess
import threading
import sys
import time
from collections import defaultdict

sys.path.insert(0, os.path.expanduser("~/tulpar/core"))
import ayarlar  # noqa: E402  (sunucu ayarları, menüden değiştirilir)

OLAY_SINIR = 5000
olaylar, kilit = [], threading.Lock()


def olay_akisi():
    """Son 3 günün olaylarını yükler, sonra canlı ekler."""
    p = subprocess.Popen(["journalctl", "-t", "tulpar", "--since", "-3 days", "-f", "-o", "short", "--no-hostname"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace")
    for satir in p.stdout:
        with kilit:
            olaylar.append(satir.rstrip("\n"))
            if len(olaylar) > OLAY_SINIR:
                del olaylar[:1000]


def oku(yol, varsayilan=""):
    try:
        with open(yol) as f:
            return f.read()
    except OSError:
        return varsayilan


def meminfo():
    d = {}
    for s in oku("/proc/meminfo").splitlines():
        k, v = s.split(":", 1)
        d[k] = int(v.split()[0])  # kB
    return d


def cpu_toplam():
    a = list(map(int, oku("/proc/stat").split("\n", 1)[0].split()[1:]))
    return sum(a), a[3] + a[4]  # toplam, boşta (idle+iowait)


def vmstat():
    d = {}
    for s in oku("/proc/vmstat").splitlines():
        k, v = s.split()
        d[k] = int(v)
    return d


def disk_okunan():
    """nvme okunan/yazılan sektör (512 bayt)."""
    oku_, yaz_ = 0, 0
    for s in oku("/proc/diskstats").splitlines():
        p = s.split()
        if p[2] == "nvme0n1":
            oku_, yaz_ = int(p[5]), int(p[9])
    return oku_, yaz_


def sicaklik():
    return max((int(oku(z, "0") or 0) // 1000 for z in glob.glob("/sys/class/thermal/thermal_zone*/temp")), default=0)


AD = {"llama-server": "Gemma (model)", "uvicorn": "Tulpar + Whisper", "node": "WhatsApp köprüsü", "wget": "indirme",
      "ttyd": "terminal", "tmux: server": "terminal (tmux)", "tailscaled": "Tailscale", "chromium": "ikinci ekran",
      "cage": "ikinci ekran"}


def surecler(onceki_cpu, gecen):
    """Uygulama bazında CPU %, RAM (RAM'de duran, model parçaları dahil), swap. Aynı adlılar toplanır."""
    grup = defaultdict(lambda: [0.0, 0, 0])
    yeni_cpu = {}
    ncpu = os.cpu_count() or 1
    for pid in filter(str.isdigit, os.listdir("/proc")):
        st = oku(f"/proc/{pid}/stat")
        if not st:
            continue
        ad = st[st.find("(") + 1:st.rfind(")")]
        alan = st[st.rfind(")") + 2:].split()
        tik = int(alan[11]) + int(alan[12])
        yeni_cpu[pid] = tik
        rss = swp = 0
        for s in oku(f"/proc/{pid}/status").splitlines():
            if s.startswith("VmRSS:"):
                rss = int(s.split()[1])
            elif s.startswith("VmSwap:"):
                swp = int(s.split()[1])
        if ad in ("python3", "python") and "uvicorn" in oku(f"/proc/{pid}/cmdline"):
            ad = "uvicorn"
        g = grup[AD.get(ad, ad)]
        if pid in onceki_cpu and gecen > 0:
            g[0] += (tik - onceki_cpu[pid]) / os.sysconf("SC_CLK_TCK") / gecen * 100 / ncpu
        g[1] += rss
        g[2] += swp
    return grup, yeni_cpu


def gemma_dosya_kb():
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if oku(f"/proc/{pid}/comm").strip() == "llama-server":
            for s in oku(f"/proc/{pid}/smaps_rollup").splitlines():
                if s.startswith("Pss_File:"):
                    return int(s.split()[1])
    return 0


def gb(kb):
    return kb / 1048576


def ciz(ekr, durum, ust, kaydir):
    ekr.erase()
    yuk, gen = ekr.getmaxyx()
    renk = lambda y: curses.color_pair(3 if y >= 95 else 2 if y >= 85 else 1)

    def yaz(y, x, metin, ozellik=0):
        if 0 <= y < yuk and x < gen:
            try:
                ekr.addnstr(y, x, metin, max(0, gen - x - 1), ozellik)
            except curses.error:
                pass

    s = durum
    yaz(0, 0, f" TULPAR  {time.strftime('%H:%M:%S')}   açık: {s['acik']}", curses.color_pair(4) | curses.A_BOLD)
    yaz(1, 1, f"Sıcaklık {s['sicak']}°C   CPU %{s['cpu']:.0f}   Model: {s['model']}")
    yaz(2, 1, "RAM ")
    yaz(2, 5, f"%{s['ram_y']}", renk(s['ram_y']) | curses.A_BOLD)
    yaz(2, 10, f"{gb(s['kul']):.1f} / {gb(s['top']):.1f} GB kullanımda  "
               f"(model önbelleği {gb(s['gdosya']):.1f} GB · gerçekten boş {gb(s['bos']):.1f} GB)")
    sw_r = 3 if s['swap'] > 512 * 1024 else 2 if s['swap'] > 100 * 1024 else 1
    yaz(3, 1, "Swap (sanal RAM, diskte) ")
    yaz(3, 26, f"{gb(s['swap']):.1f} GB", curses.color_pair(sw_r) | curses.A_BOLD)
    yaz(3, 36, f"diske {s['swap_out']:.1f} MB/sn · diskten {s['swap_in']:.1f} MB/sn · "
               f"SSD okuma {s['ssd_oku']:.0f} MB/sn yazma {s['ssd_yaz']:.0f} MB/sn")
    yaz(4, 1, f"Disk {s['disk']}   {s['indirme']}")
    yaz(5, 1, f"{'UYGULAMA':<24}{'CPU':>7}{'RAM':>10}{'SWAP':>10}", curses.A_UNDERLINE)
    satir = 6
    for ad, (cpu, rss, swp) in s['tablo']:
        yaz(satir, 1, f"{ad[:23]:<24}{cpu:>6.0f}%{gb(rss):>8.2f}GB{gb(swp):>8.2f}GB")
        satir += 1
    yaz(satir, 0, "─" * (gen - 1), curses.color_pair(5))
    alt = satir + 1
    alan = yuk - alt - 1
    with kilit:
        n = len(olaylar)
        bas = max(0, n - alan - kaydir)
        gorunen = olaylar[bas:bas + alan]
    for i, ol in enumerate(gorunen):
        r = 3 if ("HATA" in ol or "hata" in ol) else 2 if ("UYARI" in ol or "onay" in ol or "BILDIRIM" in ol) \
            else 1 if ("bitti" in ol or "hazir" in ol or "indi:" in ol or "gonderildi" in ol) else 0
        yaz(alt + i, 0, ol, curses.color_pair(r) if r else 0)
    konum = "CANLI" if kaydir == 0 else f"{kaydir} satır geride (End: canlıya dön)"
    yaz(yuk - 1, 0, f" ↑↓ PgUp PgDn kaydır · Home en eski · End canlı · s ayarlar · q çıkış   [{konum} · {n} olay]",
        curses.color_pair(5))
    ekr.refresh()
    return alan


def main(ekr):
    curses.curs_set(0)
    curses.use_default_colors()
    gri = 8 if curses.COLORS > 8 else curses.COLOR_WHITE  # 8 renkli terminallerde gri yok
    for i, c in enumerate([curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN, gri], 1):
        curses.init_pair(i, c, -1)
    ekr.timeout(1000)
    threading.Thread(target=olay_akisi, daemon=True).start()
    onceki_t = time.time()
    onceki_c = cpu_toplam()
    onceki_v = vmstat()
    onceki_d = disk_okunan()
    onceki_p = {}
    kaydir, alan = 0, 10
    while True:
        simdi = time.time()
        gecen = simdi - onceki_t
        c = cpu_toplam()
        v = vmstat()
        d = disk_okunan()
        tablo, onceki_p = surecler(onceki_p, gecen)
        m = meminfo()
        gd = gemma_dosya_kb()
        kul = min(m["MemTotal"], m["MemTotal"] - m["MemAvailable"] + gd)
        model = next((os.path.basename(a).replace(".gguf", "") for a in oku_cmd("llama-server")), "kapalı")
        sayfa = 4096 / 1048576  # MB
        durum = {
            "acik": subprocess.run(["uptime", "-p"], capture_output=True, text=True).stdout.strip().replace("up ", ""),
            "sicak": sicaklik(),
            "cpu": 100 * (1 - (c[1] - onceki_c[1]) / max(1, c[0] - onceki_c[0])),
            "model": model,
            "top": m["MemTotal"], "kul": kul, "gdosya": gd, "bos": max(0, m["MemAvailable"] - gd),
            "ram_y": int(100 * kul / m["MemTotal"]),
            "swap": m["SwapTotal"] - m["SwapFree"],
            "swap_out": (v["pswpout"] - onceki_v["pswpout"]) * sayfa / max(gecen, 0.1),
            "swap_in": (v["pswpin"] - onceki_v["pswpin"]) * sayfa / max(gecen, 0.1),
            "ssd_oku": (d[0] - onceki_d[0]) * 512 / 1048576 / max(gecen, 0.1),
            "ssd_yaz": (d[1] - onceki_d[1]) * 512 / 1048576 / max(gecen, 0.1),
            "disk": disk_ozet(),
            "indirme": indirme_ozet(),
            "tablo": sorted(tablo.items(), key=lambda x: -x[1][1])[:max(3, min(8, ekr.getmaxyx()[0] // 4))],
        }
        onceki_t, onceki_c, onceki_v, onceki_d = simdi, c, v, d
        alan = ciz(ekr, durum, None, kaydir)
        t = ekr.getch()
        with kilit:
            n = len(olaylar)
        enfazla = max(0, n - alan)
        if t in (ord("q"), ord("Q")):
            return
        elif t in (ord("s"), ord("S")):
            ayar_menusu(ekr)
        elif t == curses.KEY_UP:
            kaydir = min(enfazla, kaydir + 1)
        elif t == curses.KEY_DOWN:
            kaydir = max(0, kaydir - 1)
        elif t == curses.KEY_PPAGE:
            kaydir = min(enfazla, kaydir + alan)
        elif t == curses.KEY_NPAGE:
            kaydir = max(0, kaydir - alan)
        elif t == curses.KEY_HOME:
            kaydir = enfazla
        elif t == curses.KEY_END:
            kaydir = 0


def ayar_menusu(ekr):
    """Sunucu ayarları: ↑↓ seç, Enter değiştir, Esc/s geri. Değişiklik anında geçerli olur."""
    sec, mesaj = 0, ""
    while True:
        liste = ayarlar.liste()
        ekr.erase()
        yuk, gen = ekr.getmaxyx()

        def yaz(y, x, metin, oz=0):
            if 0 <= y < yuk:
                try:
                    ekr.addnstr(y, x, metin, max(0, gen - x - 1), oz)
                except curses.error:
                    pass
        yaz(0, 0, " TULPAR AYARLARI   ↑↓ seç · Enter değiştir · Esc/s geri", curses.color_pair(4) | curses.A_BOLD)
        satir, bolum = 2, None
        for i, a in enumerate(liste):
            if a["bolum"] != bolum:
                bolum = a["bolum"]
                yaz(satir, 1, bolum.upper(), curses.color_pair(5) | curses.A_BOLD)
                satir += 1
            vars_ = "" if a["deger"] == a["varsayilan"] else f"  (varsayılan {a['varsayilan']})"
            yaz(satir, 3, f"{a['ad']:<34}{a['deger']!s:>8}{vars_}", curses.A_REVERSE if i == sec else 0)
            satir += 1
        a = liste[sec]
        yaz(satir + 1, 1, a["aciklama"], curses.color_pair(5))
        yaz(satir + 2, 1, f"Aralık: {a['en_az']} – {a['en_cok']}")
        if mesaj:
            yaz(satir + 4, 1, mesaj, curses.color_pair(1 if mesaj.startswith("✓") else 3))
        ekr.refresh()
        t = ekr.getch()
        if t in (27, ord("s"), ord("S"), ord("q")):
            return
        if t == curses.KEY_UP:
            sec = (sec - 1) % len(liste)
        elif t == curses.KEY_DOWN:
            sec = (sec + 1) % len(liste)
        elif t in (10, 13, curses.KEY_ENTER):
            curses.echo(); curses.curs_set(1); ekr.timeout(-1)
            yaz(satir + 4, 1, f"Yeni değer ({a['ad']}): " + " " * 20)
            ekr.move(satir + 4, 3 + len(a["ad"]) + 15)
            try:
                girdi = ekr.getstr(satir + 4, 3 + len(a["ad"]) + 15, 12).decode().strip()
                if girdi:
                    deger = ayarlar.yaz(a["anahtar"], girdi)
                    subprocess.run(["logger", "-t", "tulpar", f"ayar degisti: {a['anahtar']} = {deger}"])
                    mesaj = f"✓ {a['ad']} = {deger}"
            except (ValueError, KeyError) as e:
                mesaj = f"✕ {e}"
            finally:
                curses.noecho(); curses.curs_set(0); ekr.timeout(1000)


def oku_cmd(ad):
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if oku(f"/proc/{pid}/comm").strip() == ad:
            parca = oku(f"/proc/{pid}/cmdline").split("\0")
            return [p for p in parca if p.endswith(".gguf")][:1]
    return []


def disk_ozet():
    s = os.statvfs("/")
    top, bos = s.f_blocks * s.f_frsize, s.f_bavail * s.f_frsize
    return f"{(top - bos) / 1e9:.0f}/{top / 1e9:.0f} GB (%{100 * (top - bos) / top:.0f})"


def indirme_ozet():
    if not oku_cmd_var("wget"):
        return ""
    dosyalar = sorted(glob.glob(os.path.expanduser("~/tulpar/models/*.gguf")), key=os.path.getmtime)
    return f"indiriliyor: {os.path.basename(dosyalar[-1])} {os.path.getsize(dosyalar[-1]) / 1e9:.1f} GB" if dosyalar else ""


def oku_cmd_var(ad):
    return any(oku(f"/proc/{p}/comm").strip() == ad for p in filter(str.isdigit, os.listdir("/proc")))


if __name__ == "__main__":
    curses.wrapper(main)
