#!/bin/bash
# Tulpar canlı izleme ekranı: üstte sistem durumu, altta olay akışı.
# Olaylar: logger -t tulpar "mesaj"  (servisler bu etiketle yazar)

HEADER=7

# Süreç başına gerçek bellek: RAM'de duran (Rss) ve diske taşan (Swap), MB
pbellek() { awk '/^Rss:/{r=$2} /^Swap:/{s=$2} END{printf "%.1f GB", r/1048576; if (s>102400) printf " (+%.1f GB swap!)", s/1048576}' "/proc/$1/smaps_rollup" 2>/dev/null; }
bellek() {
  local m w u sw bos
  m=$(pgrep -x llama-server | head -1); u=$(pgrep -f "uvicorn tulpar:app" | head -1)
  sw=$(free -m | awk '/Swap:/{printf "%.1f", $3/1024}')
  # "kullanılabilir" Gemma'nın RAM'deki dosya parçalarını da sayar; onlar atılırsa model diskten okumaya başlar.
  # Gerçekten boş = kullanılabilir − Gemma'nın RAM'deki dosya parçaları
  local gdosya=0; [ -n "$m" ] && gdosya=$(awk '/^Pss_File:/{print $2}' "/proc/$m/smaps_rollup" 2>/dev/null)
  bos=$(free -k | awk -v g="${gdosya:-0}" '/Mem:/{v=($7-g)/1048576; printf "%.1f", (v<0?0:v)}')
  printf "Bellek: Gemma %s · Tulpar+Whisper %s · swap %s GB · gerçekten boş %s GB" \
    "$( [ -n "$m" ] && pbellek "$m" || echo kapalı)" "$( [ -n "$u" ] && pbellek "$u" || echo -)" "$sw" "$bos"
}
cleanup() { printf '\033[r\033[?25h'; clear; kill "$FEED" 2>/dev/null; exit 0; }
trap cleanup INT TERM EXIT

temp() {
  local max=0 t
  for z in /sys/class/thermal/thermal_zone*/temp; do
    t=$(( $(cat "$z" 2>/dev/null || echo 0) / 1000 )); (( t > max )) && max=$t
  done
  echo "$max"
}
cpu() {
  read -r _ a b c d e f g _ < /proc/stat; local t1=$((a+b+c+d+e+f+g)) i1=$d
  sleep 1
  read -r _ a b c d e f g _ < /proc/stat; local t2=$((a+b+c+d+e+f+g)) i2=$d
  echo $(( 100 * ( (t2-t1) - (i2-i1) ) / (t2-t1) ))
}
color() { # değer, sarı eşiği, kırmızı eşiği
  if (( $1 >= $3 )); then printf '\033[31m'; elif (( $1 >= $2 )); then printf '\033[33m'; else printf '\033[32m'; fi
}

draw() {
  local cols t c mem used tot disk wifi model dl
  cols=$(tput cols)
  t=$(temp); c=$(cpu)
  read -r tot used cache < <(free -m | awk '/Mem:/{print $2, $3, $6}')
  mem=$(( 100 * used / tot ))
  disk=$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')
  wifi=$(awk '/wlo1/{printf "%d dBm", $4}' /proc/net/wireless 2>/dev/null)
  m=$(pgrep -a llama-server | grep -o "[^/ ]*\\.gguf" | head -1 | sed "s/\\.gguf//")
  if [ -n "$m" ]; then model="\033[32m$m\033[0m"; else model="\033[90mkapalı\033[0m"; fi
  dl=$(pgrep -f "wget.*gguf" >/dev/null && ls -t ~/tulpar/models/*.gguf 2>/dev/null | head -1 | xargs -r du -h | awk '{print "indiriliyor: "$2" "$1}' | sed "s|$HOME/tulpar/models/||")

  printf '\0337\033[1;1H'
  printf '\033[2K\033[1;36m TULPAR\033[0m  %s   açık: %s\n' "$(date '+%H:%M:%S')" "$(uptime -p | sed 's/up //')"
  printf '\033[2K Sıcaklık: %b%s°C\033[0m   CPU: %b%%%s\033[0m   RAM: %b%%%s\033[0m (%s/%s MB, model önbelleği %s MB)\n' \
    "$(color "$t" 70 85)" "$t" "$(color "$c" 60 90)" "$c" "$(color "$mem" 75 90)" "$mem" "$used" "$tot" "$cache"
  printf '\033[2K Disk: %s   Wi-Fi: %s   Model: %b\n' "$disk" "${wifi:-?}" "$model"
  printf '\033[2K %s\n' "$(bellek)"
  printf '\033[2K \033[90m%s\033[0m\n' "${dl:-}"
  printf '\033[2K\033[90m%*s\033[0m\n' "$cols" '' | tr ' ' '-'
  printf '\033[2K\n\0338'
}

clear; printf '\033[?25l'
printf '\033[%d;%dr\033[%d;1H' $((HEADER + 1)) "$(tput lines)" $((HEADER + 1))

journalctl -f -n 30 -t tulpar -o short --no-hostname 2>/dev/null | while IFS= read -r line; do
  case "$line" in
    *HATA*|*hata*|*error*) printf '\033[31m%s\033[0m\n' "$line" ;;
    *UYARI*|*onay*)        printf '\033[33m%s\033[0m\n' "$line" ;;
    *istek*|*mesaj*)       printf '\033[36m%s\033[0m\n' "$line" ;;
    *cevap*|*indi:*|*tamam*) printf '\033[32m%s\033[0m\n' "$line" ;;
    *) printf '%s\n' "$line" ;;
  esac
done &
FEED=$!

while true; do draw; sleep 1; done
