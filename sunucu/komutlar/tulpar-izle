#!/usr/bin/env python3
"""Tulpar izleme ekranı (görev yöneticisi gibi).

Üstte: sıcaklık, CPU, gerçek toplam RAM (model dahil), swap (sanal RAM) ve SSD trafiği, uygulama tablosu.
Altta: Tulpar olayları (canlı). Kaydırma: ↑↓ satır, PgUp/PgDn sayfa, Home en eski, End canlı akış.
s: sunucu ayarları menüsü. q: çıkış.
"""
import curses
import glob
import os
import subprocess
import threading
import sys
import time
from collections import defaultdict, deque

sys.path.insert(0, os.path.expanduser("~/tulpar/core"))
import ayarlar  # noqa: E402  (sunucu ayarları, menüden değiştirilir)

OLAY_SINIR = 5000
olaylar, kilit = [], threading.Lock()


def olay_akisi():
    """Son 3 günün olaylarını yükler, sonra canlı ekler."""
    p = subprocess.Popen(["journalctl", "-t", "tulpar", "--since", "-3 days", "-f", "-o", "short", "--no-hostname"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace")
    for satir in p.stdout:
        with kilit:
            olaylar.append(satir.rstrip("\n"))
            if len(olaylar) > OLAY_SINIR:
                del olaylar[:1000]


def oku(yol, varsayilan=""):
    try:
        with open(yol) as f:
            return f.read()
    except OSError:
        return varsayilan


def meminfo():
    d = {}
    for s in oku("/proc/meminfo").splitlines():
        k, v = s.split(":", 1)
        d[k] = int(v.split()[0])  # kB
    return d


def cpu_toplam():
    a = list(map(int, oku("/proc/stat").split("\n", 1)[0].split()[1:]))
    return sum(a), a[3] + a[4]  # toplam, boşta (idle+iowait)


def vmstat():
    d = {}
    for s in oku("/proc/vmstat").splitlines():
        k, v = s.split()
        d[k] = int(v)
    return d


def disk_okunan():
    """nvme okunan/yazılan sektör (512 bayt)."""
    oku_, yaz_ = 0, 0
    for s in oku("/proc/diskstats").splitlines():
        p = s.split()
        if p[2] == "nvme0n1":
            oku_, yaz_ = int(p[5]), int(p[9])
    return oku_, yaz_


def sicaklik():
    return max((int(oku(z, "0") or 0) // 1000 for z in glob.glob("/sys/class/thermal/thermal_zone*/temp")), default=0)


AD = {"llama-server": "Gemma (model)", "uvicorn": "Tulpar + Whisper", "node": "WhatsApp köprüsü", "wget": "indirme",
      "ttyd": "terminal", "tmux: server": "terminal (tmux)", "tailscaled": "Tailscale", "chromium": "ikinci ekran",
      "cage": "ikinci ekran"}


def surecler(onceki_cpu, gecen):
    """Uygulama bazında CPU %, RAM (RAM'de duran, model parçaları dahil), swap. Aynı adlılar toplanır."""
    grup = defaultdict(lambda: [0.0, 0, 0])
    yeni_cpu = {}
    ncpu = os.cpu_count() or 1
    for pid in filter(str.isdigit, os.listdir("/proc")):
        st = oku(f"/proc/{pid}/stat")
        if not st:
            continue
        ad = st[st.find("(") + 1:st.rfind(")")]
        alan = st[st.rfind(")") + 2:].split()
        tik = int(alan[11]) + int(alan[12])
        yeni_cpu[pid] = tik
        rss = swp = 0
        for s in oku(f"/proc/{pid}/status").splitlines():
            if s.startswith("VmRSS:"):
                rss = int(s.split()[1])
            elif s.startswith("VmSwap:"):
                swp = int(s.split()[1])
        if ad in ("python3", "python") and "uvicorn" in oku(f"/proc/{pid}/cmdline"):
            ad = "uvicorn"
        g = grup[AD.get(ad, ad)]
        if pid in onceki_cpu and gecen > 0:
            g[0] += (tik - onceki_cpu[pid]) / os.sysconf("SC_CLK_TCK") / gecen * 100 / ncpu
        g[1] += rss
        g[2] += swp
    return grup, yeni_cpu


def gemma_dosya_kb():
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if oku(f"/proc/{pid}/comm").strip() == "llama-server":
            for s in oku(f"/proc/{pid}/smaps_rollup").splitlines():
                if s.startswith("Pss_File:"):
                    return int(s.split()[1])
    return 0


def gb(kb):
    return kb / 1048576


RAM_RENK = {"Gemma (model)": 6, "Tulpar + Whisper": 7}
SPARK = "▁▂▃▄▅▆▇█"


def spark(degerler, en):
    """Son değerlerin mini grafiği (0-100)."""
    d = list(degerler)[-en:]
    return "".join(SPARK[min(7, int(v / 100 * 7.99))] for v in d).rjust(en)


def ciz(ekr, s, kaydir):
    ekr.erase()
    yuk, gen = ekr.getmaxyx()
    R = curses.color_pair

    def yaz(y, x, metin, oz=0, en=None):
        if 0 <= y < yuk and 0 <= x < gen - 1:
            try:
                ekr.addnstr(y, x, metin, max(0, min(en or gen, gen - x - 1)), oz)
            except curses.error:
                pass

    def kutu(y, x, h, w, baslik):
        if h < 2 or w < 4:
            return
        yaz(y, x, "╭" + "─" * (w - 2) + "╮", R(5))
        for i in range(1, h - 1):
            yaz(y + i, x, "│", R(5)); yaz(y + i, x + w - 1, "│", R(5))
        yaz(y + h - 1, x, "╰" + "─" * (w - 2) + "╯", R(5))
        yaz(y, x + 2, f" {baslik} ", R(4) | curses.A_BOLD)

    def esik(y):
        return 3 if y >= 90 else 2 if y >= 75 else 1

    def cubuk(y, x, en, oran, renk):
        dolu = int(en * max(0.0, min(1.0, oran)))
        yaz(y, x, "█" * dolu, R(renk)); yaz(y, x + dolu, "░" * (en - dolu), R(5))

    # ── üst şerit
    yaz(0, 0, " " * (gen - 1), R(8))
    yaz(0, 1, " TULPAR ", R(8) | curses.A_BOLD)
    yaz(0, 10, f"{time.strftime('%H:%M:%S')}   açık {s['acik']}   model: {s['model']}", R(8))
    if s["indirme"]:
        yaz(0, max(10, gen - len(s["indirme"]) - 3), s["indirme"], R(8))

    iki = gen >= 100
    sol_w = gen // 2 if iki else gen
    sag_x, sag_w = (sol_w, gen - sol_w) if iki else (0, gen)
    cb = max(10, sol_w - 34)  # çubuk genişliği

    # ── sol panel: sistem
    sy = 1
    sh = 11
    kutu(sy, 0, sh, sol_w, "SİSTEM")
    x = 2
    yaz(sy + 1, x, "CPU ", curses.A_BOLD); cubuk(sy + 1, x + 6, cb, s["cpu"] / 100, esik(s["cpu"]))
    yaz(sy + 1, x + 7 + cb, f"%{s['cpu']:3.0f}", R(esik(s["cpu"])) | curses.A_BOLD)
    yaz(sy + 2, x + 6, spark(s["cpu_g"], cb), R(4))

    # RAM: Gemma / Tulpar / diğer / boş renk renk
    top = s["top"]
    parcalar = [(s["gemma"], 6), (s["tulpar"], 7), (max(0, s["kul"] - s["gemma"] - s["tulpar"]), 2)]
    yaz(sy + 3, x, "RAM ", curses.A_BOLD)
    px = x + 6
    for kb, renk in parcalar:
        n = int(cb * kb / top)
        yaz(sy + 3, px, "█" * n, R(renk)); px += n
    yaz(sy + 3, px, "░" * max(0, x + 6 + cb - px), R(5))
    yaz(sy + 3, x + 7 + cb, f"%{s['ram_y']}", R(esik(s["ram_y"])) | curses.A_BOLD)
    yaz(sy + 4, x + 6, f"{gb(s['kul']):.1f}/{gb(top):.1f} GB   ", curses.A_BOLD)
    lx = x + 22
    for ad, kb, renk in (("Gemma", s["gemma"], 6), ("Tulpar", s["tulpar"], 7),
                         ("diğer", max(0, s["kul"] - s["gemma"] - s["tulpar"]), 2), ("boş", s["bos"], 5)):
        yaz(sy + 4, lx, "■", R(renk)); yaz(sy + 4, lx + 2, f"{ad} {gb(kb):.1f}"); lx += len(ad) + 8
    yaz(sy + 5, x + 6, spark(s["ram_g"], cb), R(6))

    sw_y = int(100 * s["swap"] / max(1, s["swap_top"]))
    yaz(sy + 6, x, "SWAP", curses.A_BOLD); cubuk(sy + 6, x + 6, cb, sw_y / 100, 3 if s["swap"] > 512 * 1024 else 2 if s["swap"] > 0 else 1)
    yaz(sy + 6, x + 7 + cb, f"{gb(s['swap']):.1f} GB", R(3 if s["swap"] > 512 * 1024 else 1))
    yaz(sy + 7, x + 6, f"diske ↓ {s['swap_out']:.1f} MB/s   diskten ↑ {s['swap_in']:.1f} MB/s  (RAM'e sığmayan)", R(5))
    yaz(sy + 8, x, "SSD ", curses.A_BOLD)
    yaz(sy + 8, x + 6, f"okuma {s['ssd_oku']:5.0f} MB/s   yazma {s['ssd_yaz']:4.0f} MB/s   disk {s['disk']}")
    yaz(sy + 9, x, "ISI ", curses.A_BOLD); cubuk(sy + 9, x + 6, cb, s["sicak"] / 100, esik(s["sicak"] + 5))
    yaz(sy + 9, x + 7 + cb, f"{s['sicak']}°C", R(esik(s["sicak"] + 5)) | curses.A_BOLD)

    # ── sağ panel: uygulamalar
    ry = 1 if iki else sy + sh
    rh = sh if iki else min(10, len(s["tablo"]) + 3)
    kutu(ry, sag_x, rh, sag_w, "UYGULAMALAR")
    tw = sag_w - 4
    yaz(ry + 1, sag_x + 2, f"{'':2}{'ad':<20}{'CPU':>5}  {'RAM':>8}  {'swap':>6}", R(5))
    en_cok = max((r for _, (_, r, _) in s["tablo"]), default=1) or 1
    for i, (ad, (cpu, rss, swp)) in enumerate(s["tablo"][:rh - 3]):
        y = ry + 2 + i
        renk = RAM_RENK.get(ad, 0)
        yaz(y, sag_x + 2, "●", R(renk) if renk else R(5))
        yaz(y, sag_x + 4, f"{ad[:19]:<20}", curses.A_BOLD if renk else 0)
        yaz(y, sag_x + 24, f"{cpu:4.0f}%", R(esik(cpu)) if cpu >= 1 else R(5))
        yaz(y, sag_x + 31, f"{gb(rss):6.2f}GB")
        yaz(y, sag_x + 41, f"{gb(swp):5.1f}" if swp > 10240 else "    -", R(3) if swp > 512 * 1024 else R(5))
        if tw > 52:
            cubuk(y, sag_x + 48, min(tw - 46, 20), rss / en_cok, renk or 5)

    # ── olaylar
    oy = max(sy + sh, ry + rh)
    oh = yuk - oy - 1
    kutu(oy, 0, oh, gen, "OLAYLAR")
    alan = max(1, oh - 2)
    with kilit:
        n = len(olaylar)
        bas = max(0, n - alan - kaydir)
        gorunen = olaylar[bas:bas + alan]
    for i, ol in enumerate(gorunen):
        zaman, _, metin = ol.partition(": ") if ": " in ol else ("", "", ol)
        saat = zaman.split()[2] if len(zaman.split()) >= 3 else ""
        k = metin.lower()
        simge, renk = ("✕", 3) if ("hata" in k or "error" in k) else ("⚠", 2) if ("uyari" in k or "bildirim" in k or "supheli" in k) \
            else ("✓", 1) if any(w in k for w in ("bitti", "hazir", "indi:", "gonderildi", "eklendi", "basladi", "acildi", "isitildi", "yuklendi")) \
            else ("💬", 4) if ("eleme" in k or "konusma" in k or "mesaj" in k) else ("·", 5)
        yaz(oy + 1 + i, 2, saat, R(5))
        yaz(oy + 1 + i, 11, simge, R(renk) | curses.A_BOLD)
        yaz(oy + 1 + i, 14, metin, R(renk) if renk in (2, 3) else 0, en=gen - 16)
    konum = "● CANLI" if kaydir == 0 else f"⏸ {kaydir} satır geride — End: canlı"
    yaz(oy + oh - 1, gen - len(konum) - 4, f" {konum} ", R(1 if kaydir == 0 else 2) | curses.A_BOLD)

    # ── alt şerit: kısayollar
    yaz(yuk - 1, 0, " " * (gen - 1), R(8))
    yaz(yuk - 1, 1, " ↑↓ kaydır  PgUp/PgDn sayfa  Home en eski  End canlı  s ayarlar  q çıkış ", R(8))
    yaz(yuk - 1, gen - 14, f"{n} olay ", R(8))
    ekr.refresh()
    return alan


def main(ekr):
    curses.curs_set(0)
    curses.use_default_colors()
    gri = 8 if curses.COLORS > 8 else curses.COLOR_WHITE  # 8 renkli terminallerde gri yok
    renkler = [curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN, gri,
               curses.COLOR_MAGENTA, curses.COLOR_BLUE]
    for i, c in enumerate(renkler, 1):
        curses.init_pair(i, c, -1)
    curses.init_pair(8, curses.COLOR_BLACK, curses.COLOR_CYAN)  # üst/alt şerit
    ekr.timeout(1000)
    threading.Thread(target=olay_akisi, daemon=True).start()
    onceki_t = time.time()
    onceki_c = cpu_toplam()
    onceki_v = vmstat()
    onceki_d = disk_okunan()
    onceki_p = {}
    kaydir, alan = 0, 10
    cpu_g, ram_g = deque(maxlen=200), deque(maxlen=200)
    while True:
        simdi = time.time()
        gecen = simdi - onceki_t
        c = cpu_toplam()
        v = vmstat()
        d = disk_okunan()
        tablo, onceki_p = surecler(onceki_p, gecen)
        m = meminfo()
        gd = gemma_dosya_kb()
        kul = min(m["MemTotal"], m["MemTotal"] - m["MemAvailable"] + gd)
        model = next((os.path.basename(a).replace(".gguf", "") for a in oku_cmd("llama-server")), "kapalı")
        sayfa = 4096 / 1048576  # MB
        durum = {
            "acik": subprocess.run(["uptime", "-p"], capture_output=True, text=True).stdout.strip().replace("up ", ""),
            "sicak": sicaklik(),
            "cpu": 100 * (1 - (c[1] - onceki_c[1]) / max(1, c[0] - onceki_c[0])),
            "model": model,
            "top": m["MemTotal"], "kul": kul, "gdosya": gd, "bos": max(0, m["MemAvailable"] - gd),
            "ram_y": int(100 * kul / m["MemTotal"]),
            "swap": m["SwapTotal"] - m["SwapFree"],
            "swap_out": (v["pswpout"] - onceki_v["pswpout"]) * sayfa / max(gecen, 0.1),
            "swap_in": (v["pswpin"] - onceki_v["pswpin"]) * sayfa / max(gecen, 0.1),
            "ssd_oku": (d[0] - onceki_d[0]) * 512 / 1048576 / max(gecen, 0.1),
            "ssd_yaz": (d[1] - onceki_d[1]) * 512 / 1048576 / max(gecen, 0.1),
            "disk": disk_ozet(),
            "indirme": indirme_ozet(),
            "tablo": sorted(tablo.items(), key=lambda x: -x[1][1])[:8],
            "swap_top": m["SwapTotal"],
            "gemma": tablo.get("Gemma (model)", [0, 0, 0])[1],
            "tulpar": tablo.get("Tulpar + Whisper", [0, 0, 0])[1],
        }
        cpu_g.append(durum["cpu"]); ram_g.append(durum["ram_y"])
        durum["cpu_g"], durum["ram_g"] = cpu_g, ram_g
        onceki_t, onceki_c, onceki_v, onceki_d = simdi, c, v, d
        alan = ciz(ekr, durum, kaydir)
        t = ekr.getch()
        with kilit:
            n = len(olaylar)
        enfazla = max(0, n - alan)
        if t in (ord("q"), ord("Q")):
            return
        elif t in (ord("s"), ord("S")):
            ayar_menusu(ekr)
        elif t == curses.KEY_UP:
            kaydir = min(enfazla, kaydir + 1)
        elif t == curses.KEY_DOWN:
            kaydir = max(0, kaydir - 1)
        elif t == curses.KEY_PPAGE:
            kaydir = min(enfazla, kaydir + alan)
        elif t == curses.KEY_NPAGE:
            kaydir = max(0, kaydir - alan)
        elif t == curses.KEY_HOME:
            kaydir = enfazla
        elif t == curses.KEY_END:
            kaydir = 0


def ayar_menusu(ekr):
    """Sunucu ayarları: ↑↓ seç, Enter değiştir, Esc/s geri. Değişiklik anında geçerli olur."""
    sec, mesaj = 0, ""
    while True:
        liste = ayarlar.liste()
        ekr.erase()
        yuk, gen = ekr.getmaxyx()

        def yaz(y, x, metin, oz=0):
            if 0 <= y < yuk:
                try:
                    ekr.addnstr(y, x, metin, max(0, gen - x - 1), oz)
                except curses.error:
                    pass
        yaz(0, 0, " TULPAR AYARLARI   ↑↓ seç · Enter değiştir · Esc/s geri", curses.color_pair(4) | curses.A_BOLD)
        satir, bolum = 2, None
        for i, a in enumerate(liste):
            if a["bolum"] != bolum:
                bolum = a["bolum"]
                yaz(satir, 1, bolum.upper(), curses.color_pair(5) | curses.A_BOLD)
                satir += 1
            vars_ = "" if a["deger"] == a["varsayilan"] else f"  (varsayılan {a['varsayilan']})"
            yaz(satir, 3, f"{a['ad']:<34}{a['deger']!s:>8}{vars_}", curses.A_REVERSE if i == sec else 0)
            satir += 1
        a = liste[sec]
        yaz(satir + 1, 1, a["aciklama"], curses.color_pair(5))
        yaz(satir + 2, 1, f"Aralık: {a['en_az']} – {a['en_cok']}")
        if mesaj:
            yaz(satir + 4, 1, mesaj, curses.color_pair(1 if mesaj.startswith("✓") else 3))
        ekr.refresh()
        t = ekr.getch()
        if t in (27, ord("s"), ord("S"), ord("q")):
            return
        if t == curses.KEY_UP:
            sec = (sec - 1) % len(liste)
        elif t == curses.KEY_DOWN:
            sec = (sec + 1) % len(liste)
        elif t in (10, 13, curses.KEY_ENTER):
            curses.echo(); curses.curs_set(1); ekr.timeout(-1)
            yaz(satir + 4, 1, f"Yeni değer ({a['ad']}): " + " " * 20)
            ekr.move(satir + 4, 3 + len(a["ad"]) + 15)
            try:
                girdi = ekr.getstr(satir + 4, 3 + len(a["ad"]) + 15, 12).decode().strip()
                if girdi:
                    deger = ayarlar.yaz(a["anahtar"], girdi)
                    subprocess.run(["logger", "-t", "tulpar", f"ayar degisti: {a['anahtar']} = {deger}"])
                    mesaj = f"✓ {a['ad']} = {deger}"
            except (ValueError, KeyError) as e:
                mesaj = f"✕ {e}"
            finally:
                curses.noecho(); curses.curs_set(0); ekr.timeout(1000)


def oku_cmd(ad):
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if oku(f"/proc/{pid}/comm").strip() == ad:
            parca = oku(f"/proc/{pid}/cmdline").split("\0")
            return [p for p in parca if p.endswith(".gguf")][:1]
    return []


def disk_ozet():
    s = os.statvfs("/")
    top, bos = s.f_blocks * s.f_frsize, s.f_bavail * s.f_frsize
    return f"{(top - bos) / 1e9:.0f}/{top / 1e9:.0f} GB (%{100 * (top - bos) / top:.0f})"


def indirme_ozet():
    if not oku_cmd_var("wget"):
        return ""
    dosyalar = sorted(glob.glob(os.path.expanduser("~/tulpar/models/*.gguf")), key=os.path.getmtime)
    return f"indiriliyor: {os.path.basename(dosyalar[-1])} {os.path.getsize(dosyalar[-1]) / 1e9:.1f} GB" if dosyalar else ""


def oku_cmd_var(ad):
    return any(oku(f"/proc/{p}/comm").strip() == ad for p in filter(str.isdigit, os.listdir("/proc")))


if __name__ == "__main__":
    curses.wrapper(main)
