#!/bin/bash
# Tulpar canlı izleme ekranı: üstte sistem durumu, altta olay akışı.
# Olaylar: logger -t tulpar "mesaj"  (servisler bu etiketle yazar)
# Geçmiş olayları kaydırarak okumak için: tulpar-izle gecmis   (↑↓ / PgUp PgDn, q ile çık)

if [ "$1" = "gecmis" ]; then
  exec journalctl -t tulpar --since "-3 days" -o short --no-hostname --no-pager | less -R +G
fi

HEADER=8

# Bellek (GB): bir sürecin RAM'de duran kısmı (dosyadan eşlenen model parçaları dahil)
rss() { [ -n "$1" ] && awk '/^Rss:/{printf "%.1f", $2/1048576}' "/proc/$1/smaps_rollup" 2>/dev/null || echo 0; }
bellek_satirlari() {
  local m u w gdosya
  m=$(pgrep -x llama-server | head -1); u=$(pgrep -f "uvicorn tulpar:app" | head -1); w=$(pgrep -f "node kopru.mjs" | head -1)
  gdosya=0; [ -n "$m" ] && gdosya=$(awk '/^Pss_File:/{print $2}' "/proc/$m/smaps_rollup" 2>/dev/null)
  # Toplam kullanım = programların kendi belleği + Gemma'nın RAM'deki model parçaları (Linux bunları "önbellek" sayar)
  free -k | awk -v g="${gdosya:-0}" -v gm="$(rss "$m")" -v tu="$(rss "$u")" -v wa="$(rss "$w")" '
    /Mem:/  {tot=$2; kul=$2-$7+g; if (kul>tot) kul=tot; bos=$7-g; if (bos<0) bos=0}
    /Swap:/ {sw=$3}
    END {
      yuzde=int(100*kul/tot); diger=kul/1048576-gm-tu-wa; if (diger<0) diger=0
      renk = yuzde>=95 ? "\033[31m" : (yuzde>=85 ? "\033[33m" : "\033[32m")
      printf "RAM: %s%%%d\033[0m (%.1f / %.1f GB kullanımda, gerçekten boş %.1f GB)%s\n", renk, yuzde, kul/1048576, tot/1048576, bos/1048576, (sw>102400 ? sprintf("  \033[31mswap %.1f GB\033[0m", sw/1048576) : "")
      printf "  Gemma %.1f GB · Tulpar+Whisper %.1f GB · WhatsApp %.1f GB · sistem ve diğer %.1f GB", gm, tu, wa, diger
    }'
}
cleanup() { printf '\033[r\033[?25h'; clear; kill "$FEED" 2>/dev/null; exit 0; }
trap cleanup INT TERM EXIT

temp() {
  local max=0 t
  for z in /sys/class/thermal/thermal_zone*/temp; do
    t=$(( $(cat "$z" 2>/dev/null || echo 0) / 1000 )); (( t > max )) && max=$t
  done
  echo "$max"
}
cpu() {
  read -r _ a b c d e f g _ < /proc/stat; local t1=$((a+b+c+d+e+f+g)) i1=$d
  sleep 1
  read -r _ a b c d e f g _ < /proc/stat; local t2=$((a+b+c+d+e+f+g)) i2=$d
  echo $(( 100 * ( (t2-t1) - (i2-i1) ) / (t2-t1) ))
}
color() { # değer, sarı eşiği, kırmızı eşiği
  if (( $1 >= $3 )); then printf '\033[31m'; elif (( $1 >= $2 )); then printf '\033[33m'; else printf '\033[32m'; fi
}

draw() {
  local cols t c disk wifi model dl
  cols=$(tput cols)
  t=$(temp); c=$(cpu)
  disk=$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')
  wifi=$(awk '/wlo1/{printf "%d dBm", $4}' /proc/net/wireless 2>/dev/null)
  m=$(pgrep -a llama-server | grep -o "[^/ ]*\\.gguf" | head -1 | sed "s/\\.gguf//")
  if [ -n "$m" ]; then model="\033[32m$m\033[0m"; else model="\033[90mkapalı\033[0m"; fi
  dl=$(pgrep -x wget >/dev/null && ls -t ~/tulpar/models/*.gguf 2>/dev/null | head -1 | xargs -r du -h | awk '{print "indiriliyor: "$2" "$1}' | sed "s|$HOME/tulpar/models/||")

  printf '\0337\033[1;1H'
  printf '\033[2K\033[1;36m TULPAR\033[0m  %s   açık: %s   \033[90m(geçmiş: tulpar-izle gecmis)\033[0m\n' "$(date '+%H:%M:%S')" "$(uptime -p | sed 's/up //')"
  printf '\033[2K Sıcaklık: %b%s°C\033[0m   CPU: %b%%%s\033[0m   Disk: %s   Wi-Fi: %s\n' \
    "$(color "$t" 70 85)" "$t" "$(color "$c" 60 90)" "$c" "$disk" "${wifi:-?}"
  bellek_satirlari | while IFS= read -r l; do printf '\033[2K %b\n' "$l"; done
  printf '\033[2K Model: %b\n' "$model"
  printf '\033[2K \033[90m%s\033[0m\n' "${dl:-}"
  printf '\033[2K\033[90m%*s\033[0m\n' "$cols" '' | tr ' ' '-'
  printf '\033[2K\n\0338'
}

clear; printf '\033[?25l'
printf '\033[%d;%dr\033[%d;1H' $((HEADER + 1)) "$(tput lines)" $((HEADER + 1))

journalctl -f -n 30 -t tulpar -o short --no-hostname 2>/dev/null | while IFS= read -r line; do
  case "$line" in
    *HATA*|*hata*|*error*) printf '\033[31m%s\033[0m\n' "$line" ;;
    *UYARI*|*onay*)        printf '\033[33m%s\033[0m\n' "$line" ;;
    *istek*|*mesaj*)       printf '\033[36m%s\033[0m\n' "$line" ;;
    *cevap*|*indi:*|*tamam*) printf '\033[32m%s\033[0m\n' "$line" ;;
    *) printf '%s\n' "$line" ;;
  esac
done &
FEED=$!

while true; do draw; sleep 1; done
